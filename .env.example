# RecoverX Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///./recoverx.db

# Redis (optional - falls back to in-memory)
REDIS_URL=

# Razorpay (optional - runs in demo mode without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM (optional - uses rule-based explanations without these)
LLM_API_KEY=
LLM_BASE_URL=
MODEL_NAME=gpt-4

# Application
DEMO_MODE=true

# Recovery Policy Defaults
MAX_RETRIES_PER_TRANSACTION=3
RETRY_COOLDOWN_MINUTES=15
MAX_RECOVERY_ATTEMPTS_PER_CUSTOMER=5
DEFAULT_DAILY_RECOVERY_BUDGET=5000.0
MAX_AUTO_RECOVERY_AMOUNT=50000.0

# ML
ML_MODEL_PATH=ml/models
